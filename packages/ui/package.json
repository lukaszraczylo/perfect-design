{
  "name": "@perfect-design/ui",
  "version": "0.1.0",
  "description": "Universal Vue 3 + Tailwind 4 component library. Runtime deps: reka-ui, tailwind-merge (+ optional pinia).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./dist/*": "./dist/*"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./themes/*.css": "./src/styles/themes/*.css",
    "./packs.css": "./src/styles/packs.css",
    "./packs/*.css": "./src/styles/packs/*.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "build:check": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "pinia": "^3.0.0 || ^4.0.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  }
}
